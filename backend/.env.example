# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated allowed origins, or * for any
CORS_ORIGIN=*

# ── MySQL ───────────────────────────────────────────────
# The DB user MUST be allowed to CREATE DATABASE — every business gets its own database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
# Master (platform) database: shops, logins, platform settings
DB_NAME=supermart_master
# Each business database is named <prefix><shopId>, e.g. sm_shop_1, sm_shop_2
TENANT_DB_PREFIX=sm_shop_
# Close a shop's DB connection after this many idle minutes
TENANT_IDLE_MINUTES=30
# Set true ONCE after upgrading the app to add new columns to existing tables
DB_SYNC_ALTER=false
DB_LOGGING=false

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Platform super admin (created on first start) ──────
ADMIN_EMAIL=admin@supermarket.com
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=Admin
DEFAULT_SHOP_NAME=Demo Supermarket

# ── Only for scripts/migrate-legacy.js (old single-database app) ─
LEGACY_DB_NAME=supermarket_db
